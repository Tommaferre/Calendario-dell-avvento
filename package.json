{
  "name": "christmas-advent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:build": "node scripts/build-content.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "sw:build": "node scripts/build-sw.mjs",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "reminder:dry-run": "node scripts/send-advent-reminder.mjs --dry-run",
    "reminder:test": "node scripts/send-advent-reminder.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
